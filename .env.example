# Copy to .env and edit. Every value here is optional; these are the defaults.

# --- GPU ----------------------------------------------------------------------
# Which GPU of the host runs the model: its index or (better) its UUID, from
#   nvidia-smi -L
# On a host with a single GPU, 0 is right. ./check-host.sh prints the P100's.
GPU_DEVICE=0

# --- API ----------------------------------------------------------------------
# Host interface the API is published on: 0.0.0.0 = every interface (reachable
# from the network), 127.0.0.1 = this machine only.
HOST=0.0.0.0
PORT=8080
# If set, every /v1 request must send "Authorization: Bearer <API_KEY>".
API_KEY=

# Speculative decoding with the model's MTP head: ~1.5x faster generation,
# maximum context ~80k tokens instead of ~100k. 1 = on, 0 = off.
MTP=1

# --- Model download -------------------------------------------------------------
# Where the weights live on the host (~12.3 GB). Downloaded on the first start
# if missing; an existing copy of orcarouter/OrcaSAQ-2-27B can be pointed to here
# (the folder that CONTAINS OrcaSAQ-2-27B/).
MODELS_DIR=./models
# Optional Hugging Face token (https://huggingface.co/settings/tokens, read
# access): higher download rate limits.
HF_TOKEN=
# Checkpoint revision. Empty = the one this project was tested with.
HF_REVISION=

# --- Files ----------------------------------------------------------------------
# The container runs as this user, so downloaded files belong to you on the
# host. `id -u` / `id -g` print yours.
PUID=1000
PGID=1000
